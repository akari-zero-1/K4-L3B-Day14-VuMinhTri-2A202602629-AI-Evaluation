# Used by domain_assistant.py when generating real RAG answers.
# Copy this file to .env, then configure your chosen provider and API key.

# ==============================================================================
# 0. CHỌN PROVIDER (Tự động nhận diện nếu để trống)
# Các lựa chọn: groq | openrouter | gemini | openai
# ==============================================================================
LLM_PROVIDER=groq

# ==============================================================================
# 1. GROQ (Rất nhanh và miễn phí - Khuyên dùng)
# Lấy API Key miễn phí tại: https://console.groq.com/keys
# ==============================================================================
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Các model gợi ý khác trên Groq:
# - llama-3.1-8b-instant (cực nhanh, nhẹ)
# - mixtral-8x7b-32768
# - gemma2-9b-it

# ==============================================================================
# 2. OPENROUTER (Tổng hợp hàng trăm model: Llama, DeepSeek, Claude, Gemini...)
# Lấy API Key tại: https://openrouter.ai/keys
# ==============================================================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# Các model gợi ý khác trên OpenRouter:
# - deepseek/deepseek-chat
# - google/gemini-2.0-flash-001
# - meta-llama/llama-3.1-8b-instruct:free (miễn phí)

# ==============================================================================
# 3. GOOGLE GEMINI (OpenAI-compatible endpoint)
# Lấy API Key tại: https://aistudio.google.com/app/apikey
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
# Các model khác: gemini-1.5-flash, gemini-1.5-pro

# ==============================================================================
# 4. OPENAI
# Lấy API Key tại: https://platform.openai.com/api-keys
# ==============================================================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
